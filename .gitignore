# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev data layer (regenerated by the seed script; never the source of truth)
/.data/

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI's own local cache (created just by running `npx supabase`, unrelated to
# this project's actual migrations)
/supabase/.temp/
